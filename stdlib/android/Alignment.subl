// android/ui/Alignment.subl —— 对齐常量（android doc/安卓标准库.md §布局）
//
// contentAlignment 的取值。整型 value 由 KT 端解析为原生 Gravity。

struct Alignment(value: Int = 0)

fun Center(): Alignment = Alignment(0)
fun TopStart(): Alignment = Alignment(1)
fun BottomEnd(): Alignment = Alignment(2)
fun CenterStart(): Alignment = Alignment(3)
fun CenterEnd(): Alignment = Alignment(4)
fun Top(): Alignment = Alignment(5)
fun Bottom(): Alignment = Alignment(6)
