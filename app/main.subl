// 用药记录 app —— 记录吃药的药名与剂量，时间线展示服药时间点（可滑动），storage 持久化。
// 数据层见 meds.subl（"name | amount | time" 编码、storage 键 "meds"）；
// 时间线组件见 TimelineView.subl；视图机制见 android doc/安卓标准库.md。

@impure
fun main(): Null {
    onCreate {
        unchecked log("med app started", 2)
    }
    onStart {
        layout(content)
    }
}

@composable
fun content(): Box {
    @mut var nameField = TextField(placeholder = "药名")
    @mut var amountField = TextField(placeholder = "剂量，如 1 片")
    // 冷启动：从 storage 恢复历史记录（unchecked 逃逸纯度检查）。
    unchecked @mut var meds: List[Str] = loadMeds()
    @mut var curTime: Str = ""
    @mut var status = Text(text = concat(concat("共 ", toStr(size(meds))), " 条"))
    @mut var rows = rowsView(meds)
    @mut var timeline = TimelineView(times = medTimes(meds), labels = medLabels(meds))
    return Box(modifier = Plain()) {
        Box(modifier = Plain()) {
            Text(text = "用药记录", size = 22, bold = true)
        }
        Box(modifier = Plain()) { nameField }
        Box(modifier = Plain()) { amountField }
        Box(modifier = Plain(), orientation = "horizontal") {
            Button(onClick = {
                unchecked curTime = nowStr()
                meds = makeDose(meds, nameField.text, amountField.text, curTime)
                unchecked saveMeds(meds)
                status.text = concat(concat("共 ", toStr(size(meds))), " 条")
                rows = rowsView(meds)
                timeline = TimelineView(times = medTimes(meds), labels = medLabels(meds))
                nameField.text = ""
                amountField.text = ""
            }) {
                Text(text = "＋ 添加")
            }
            Button(onClick = {
                meds = emptyList()
                unchecked saveMeds(meds)
                status.text = "共 0 条"
                rows = rowsView(emptyList())
                timeline = TimelineView()
            }) {
                Text(text = "清空")
            }
        }
        Box(modifier = Plain()) { status }
        Box(modifier = Plain()) { rows }
        Box(modifier = Plain()) { timeline }
    }
}

// 记录列表：每条一行（倒序，最新在最上）。
@composable fun rowsView(meds: List[Str]): Box = Box(modifier = Plain()) {
    rowsBody(reverse(meds))
}

@composable fun rowsBody(xs: List[Str]): Any = when (xs) {
    Nil => Box(modifier = Plain()) {}
    is Cons(m, rest) => Box(modifier = Plain(), orientation = "vertical") {
        Text(text = m, size = 15)
        rowsBody(rest)
    }
}
